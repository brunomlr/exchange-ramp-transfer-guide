# Ramps / Exchanges Transfer Simulator — copy to .env.local and fill in (testnet)
NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org

# Exchange deposit destination (base G account) + fixed demo deposit id
NEXT_PUBLIC_EXCHANGE_G=
NEXT_PUBLIC_DEPOSIT_ID=1234567890

# User wallets
NEXT_PUBLIC_USER_G=
NEXT_PUBLIC_USER_CONTRACT_C=
# Verifier the smart account's ed25519 signer is registered against
NEXT_PUBLIC_ED25519_VERIFIER=

# Token contracts — XLM SAC is required; others enable their option when set
NEXT_PUBLIC_XLM_SAC=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC
NEXT_PUBLIC_USDC_SAC=
# Custom SEP-41 Soroban token (OpenZeppelin stellar-tokens) — used by both flows
NEXT_PUBLIC_SEP41_TOKEN=

# Server-side only — secrets used for signing (no NEXT_PUBLIC_ prefix)
# USER_G_SECRET: the classic wallet's secret, and the fee payer for every send.
# CONTRACT_SIGNER_SECRET: the smart account's registered ed25519 signer.
USER_G_SECRET=
CONTRACT_SIGNER_SECRET=
# EXCHANGE_G_SECRET: used by /api/withdraw — the exchange signs withdrawals from
# its own G account. Must be the secret for NEXT_PUBLIC_EXCHANGE_G (funded on testnet).
EXCHANGE_G_SECRET=
